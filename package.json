    "./ckb": "./dist/ckb.mjs",
    "./CkbDidProvider": "./dist/CkbDidProvider.mjs",
    "./contracts": "./dist/contracts.mjs",
    "./IdentityProviderRegistry": "./dist/IdentityProviderRegistry.mjs",
    "./JoyIdCredentials": "./dist/JoyIdCredentials.mjs",
    "./OwnershipMessage": "./dist/OwnershipMessage.mjs",
    "./plugin": "./dist/plugin.mjs",
